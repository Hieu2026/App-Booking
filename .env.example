# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit file .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Khóa công khai (anon / publishable). An toàn để lộ ở trình duyệt vì dữ liệu được bảo vệ bằng RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khóa BÍ MẬT (service_role / secret). Chỉ dùng ở máy chủ để quản lý tài khoản.
# Không đặt tiền tố NEXT_PUBLIC_, không đưa vào mã nguồn.
SUPABASE_SERVICE_ROLE_KEY=

# (Tùy chọn) Số giây giữa các lần tự làm mới dự phòng khi mất kênh realtime. Mặc định 20.
NEXT_PUBLIC_POLL_SECONDS=20
